LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL=local

SQL_SERVER=localhost
SQL_DATABASE=SalesAI_DB
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=true
SQL_USERNAME=
SQL_PASSWORD=

APP_ENV=development
LOG_LEVEL=INFO

SQL_QUERY_TIMEOUT=30
MAX_RESULT_ROWS=1000

# Role-based access control. JSON map of API key -> {"name": ..., "role": "admin"|"analyst"|"viewer"}.
# The defaults below (dev-admin-key / dev-analyst-key / dev-viewer-key) are for local
# development only. Generate real, unique, secret keys before deploying anywhere shared.
API_KEYS={"dev-admin-key": {"name": "dev-admin", "role": "admin"}, "dev-analyst-key": {"name": "dev-analyst", "role": "analyst"}, "dev-viewer-key": {"name": "dev-viewer", "role": "viewer"}}
